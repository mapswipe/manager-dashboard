    "description": "Manager Dashboard for the MapSwipe",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mapswipe/python-mapswipe-workers.git"
    },
    "scripts": {
        "generate:type": "dotenv -- cross-var openapi-typescript \"%APP_API_ENDPOINT%api-docs/\" -o ./generated/types.ts --alphabetize",
        "prestart": "pnpm initialize:type",
        "initialize:type": "echo 'TODO: implement type initialization'",
        "start": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "pretypecheck": "pnpm initialize:type",
        "typecheck": "tsc",
        "test": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "pnpm lint:js && pnpm lint:css && pnpm lint:unused",
        "lint:fix": "pnpm lint:js --fix && pnpm lint:css --fix",
        "lint:js": "eslint app",
        "lint:css": "stylelint \"./app/**/*.css\"",
        "lint:unused": "knip --tags=-knipignore"
    },
